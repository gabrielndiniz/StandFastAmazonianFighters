
# Auto detect text files and perform LF normalization
* text=auto

# C++ source
*.cpp  text eol=lf diff=cpp
*.h    text eol=lf diff=cpp
*.hpp  text eol=lf diff=cpp

# Unreal project files
*.uproject  text eol=lf
*.uplugin   text eol=lf
*.ini       text eol=lf
*.cs        text eol=lf

# Binarios do UE - nunca tocar
*.uasset  binary
*.umap    binary
*.pak     binary
*.png     binary
*.jpg     binary
*.wav     binary
*.mp3     binary
'@ | Out-File -Encoding UTF8 .gitattributes